# 🌐 Environment
APP_ENV=localhost
APP_PORT=3000
APP_URL=http://localhost:3000

TIME_ZONE=Asia/Bangkok

# 📦 Database (PostgreSQL)
AUTO_MIGRATE=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiber-ecommerce-api
DB_USER=postgres
DB_PASS=admin
DB_SSL=disable

# 🔐 JWT Config
JWT_SECRET=some_secure_jwt_secret_key
JWT_EXPIRES_IN=24h

# 👑 Admin User Seeding (Required for first-time setup)
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=adminP@ssw0rd
ADMIN_FIRST_NAME=admin
ADMIN_LAST_NAME=admin